# ============================================================
#  SENTINEL FACE — Variables de Entorno del Monorepositorio
#  Copia este archivo como .env en la raíz para personalizar
# ============================================================

# ── Base de datos MariaDB ──────────────────────────────────
HOST_DB_PORT=3307
DB_HOST=db
DB_PORT=3306
DB_NAME=sentinel_face
DB_USER=sentinel
DB_PASSWORD=sentinel_pass
DB_ROOT_PASSWORD=sentinel_root_pass
DB_POOL_SIZE=10

# ── Backend Flask API ──────────────────────────────────────
BACKEND_PORT=5000
JWT_SECRET_KEY=sentinel_super_secret_jwt_key_2026_xyz123456789
JWT_ACCESS_TOKEN_EXPIRES=3600
ALLOWED_ORIGINS=*
RATELIMIT_STORAGE_URL=memory://

# ── Web Admin Frontend ─────────────────────────────────────
WEB_PORT=80

# ── Credenciales del Administrador Inicial (Seed) ───────────
ADMIN_DEFAULT_EMAIL=admin@admin.com
ADMIN_DEFAULT_PASSWORD=AdminSentinel2026!
