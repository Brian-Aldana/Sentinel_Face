# ============================================================
#  SENTINEL_FACE — Monorepo .gitignore
# ============================================================

# ── Entornos Virtuales y Dependencias Python ────────────────
.venv/
venv/
env/
ENV/
*.venv
Pipfile.lock

# ── Caché y Compilación Python ─────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Dependencias Node / React Native / Expo ────────────────
node_modules/
.expo/
.expo-shared/
dist/
build/
web-build/
*.tsbuildinfo

# ── Variables de Entorno y Secretos ────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ── Datos Persistentes y Volúmenes de Docker ───────────────
db_data/
mariadb_data/
data/

# ── Modelos Pesados y Temporales de Biometría ──────────────
*.onnx
*.task
*.engine
SENTINEL_FACE_BACKEND/models/buffalo_l/
SENTINEL_FACE_BACKEND/models/*.task

# ── Logs y Depuración ──────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Configuraciones de IDE y Sistema Operativo ─────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
