# URL base del backend en Railway (sin slash final)
API_URL=https://sentinelfacebackend-production.up.railway.app/api

# Número de frames enviados por reconocimiento (recomendado: 3-7, NO usar más de 10)
N_FRAMES=5

# Segundos de espera entre reconocimientos para la misma cámara
COOLDOWN=4.0

# Frames consecutivos con cara detectada antes de habilitar trigger manual
FACE_STABLE_THRESHOLD=6

# Resolución de captura (ancho x alto)
CAP_WIDTH=640
CAP_HEIGHT=480

# Calidad JPEG de los frames enviados al backend (0-100)
# Recomendado: 70-80 para reducir tamaño sin perder calidad facial
JPEG_QUALITY=75

# Timeout en segundos para las peticiones HTTP al backend
# Aumentar si Railway hace cold start frecuente (>20s)
REQUEST_TIMEOUT=30
