{
  "expo": {
    "name": "Sentinel Face",
    "slug": "APP_MOVIL_SENTINEL_FACE",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "appmovilsentinelface",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sentinelface.mobile",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/facial_scan_bg.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c4d4499e-f7dd-47dd-a89e-37e42279ca69"
      }
    }
  }
}
